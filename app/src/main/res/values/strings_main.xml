    <!-- First-run sharing texts, now in Quick Setup's Library step (ui/setup/QuickSetupScreen.kt) -->
    <string name="app_consent_step">%1$d of %2$d</string>
    <string name="app_consent_library_title">Contribute to the Library?</string>
    <string name="app_consent_library_body">BeatRadar can share the titles, tempos and audio fingerprints of the songs it hears, so anyone can search a public tempo library. Fingerprints can\'t be turned back into sound, voices or words. No account needed; if you sign in, your nickname shows on leaderboards.</string>
    <string name="app_consent_clips_title">Help name unknown songs?</string>
    <string name="app_consent_clips_body">When BeatRadar can\'t name a song, it can send a 12-second clip of it, so an admin can listen and name it for everyone. Only music is clipped, clips are deleted within 30 days, and turning this off later deletes yours from the server.</string>
    <string name="app_consent_change_later">You can change this anytime in Settings.</string>

