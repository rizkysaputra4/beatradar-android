    <string name="app_setup_hear_title">Let BeatRadar listen</string>
    <string name="app_setup_hear_body">BeatRadar hears the beat through your microphone. The sound is analysed on your phone; no audio leaves it unless you choose to share clips.</string>
    <string name="app_setup_mic_title">Microphone</string>
    <string name="app_setup_mic_desc">Needed to hear the beat. A notification shows while it listens.</string>
    <string name="app_setup_mic_allowed">Allowed</string>
    <string name="app_setup_mic_denied">Not allowed. You can allow it later, when you tap Start.</string>
    <string name="app_setup_allow_mic">Allow microphone</string>
    <string name="app_setup_names_title">Name songs automatically</string>
    <string name="app_setup_names_desc">Optional: reads song titles from music apps and Shazam notifications. Nothing leaves your phone.</string>
    <string name="app_setup_allow">Allow</string>
    <string name="app_setup_library_title">Help build the Library</string>
    <string name="app_setup_library_body">The songs you hear can add their tempo to a free library anyone can search. You choose what to share.</string>
    <string name="app_setup_account_title">Save your progress</string>
    <string name="app_setup_account_body">With an account you get a nickname on the leaderboards, can love songs, and your log is backed up to every phone. Everything else works without one.</string>
    <string name="app_setup_nickname_preview">Your nickname on the leaderboards. You can change it.</string>
